{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quantum Shield - Phase 1 ingestion output (v1.0)",
  "description": "Contract between Sahil (ingestion) and Ritesh (AST/graph). Ritesh reads `files[]` and parses each `path` under `local_path`.",
  "type": "object",
  "required": ["schema_version", "source", "local_path", "summary", "files"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "type": "string" },
    "local_path": { "type": "string" },
    "commit": { "type": ["string", "null"] },
    "summary": {
      "type": "object",
      "properties": {
        "total_files": { "type": "integer" },
        "by_language": { "type": "object", "additionalProperties": { "type": "integer" } },
        "files_with_crypto_hints": { "type": "integer" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language", "kind", "size_bytes", "sha256", "line_count", "crypto_hints"],
        "properties": {
          "path": { "type": "string", "description": "relative to local_path, '/' separated" },
          "language": { "type": "string" },
          "kind": { "enum": ["source", "config", "certificate", "key"] },
          "size_bytes": { "type": "integer" },
          "sha256": { "type": "string" },
          "line_count": { "type": "integer" },
          "crypto_hints": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
